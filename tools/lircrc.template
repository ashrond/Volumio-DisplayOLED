# Managed by the Synthwave Display plugin.
# Every IR button is forwarded to the display program over a localhost UDP
# datagram (see tools/ir_dispatch.sh). The display owns routing — it either
# consumes the button (menu nav, skip animation feedback) or forwards it to
# Volumio. Do not put direct "volumio <cmd>" actions here or the display
# will be bypassed.

begin
    prog = irexec
    button = KEY_PLAY
    config = /data/plugins/user_interface/synthwave_display/display/tools/ir_dispatch.sh KEY_PLAY
end
begin
    prog = irexec
    button = KEY_RIGHT
    config = /data/plugins/user_interface/synthwave_display/display/tools/ir_dispatch.sh KEY_RIGHT
end
begin
    prog = irexec
    button = KEY_LEFT
    config = /data/plugins/user_interface/synthwave_display/display/tools/ir_dispatch.sh KEY_LEFT
end
begin
    prog = irexec
    button = KEY_UP
    config = /data/plugins/user_interface/synthwave_display/display/tools/ir_dispatch.sh KEY_UP
end
begin
    prog = irexec
    button = KEY_DOWN
    config = /data/plugins/user_interface/synthwave_display/display/tools/ir_dispatch.sh KEY_DOWN
end
begin
    prog = irexec
    button = KEY_MENU
    config = /data/plugins/user_interface/synthwave_display/display/tools/ir_dispatch.sh KEY_MENU
end
